---
// Alta de testers para la PRUEBA CERRADA de Google Play.
//
// Por qué esta página existe: la Play Developer API solo acepta GRUPOS de Google
// como lista de testers (nunca correos sueltos), así que el grupo
// kamay-testers@googlegroups.com —registrado una vez en Play Console— ES la lista.
// Aquí solo (1) guardamos el correo para nuestra auditoría de permanencia y
// (2) llevamos a la persona a unirse al grupo y a aceptar la prueba.
//
// Sitio estático en GitHub Pages: el POST va del navegador al RPC
// nk_register_tester con la publishable key, igual que el visor en vivo de
// 404.astro. La tabla nk_testers está cerrada (sin políticas ni grants); solo esa
// RPC SECURITY DEFINER escribe, así que la key pública no puede leer los correos.
import { withBase } from '../i18n/utils';
import { SITE } from '../config';
const logo = withBase('/icon.png');
const home = withBase('/');
const privacidad = withBase('/privacidad');
const ogImage = withBase('/og.png');
const title = 'Sé tester de Ñan Kamay';
const description =
  'Apúntate a la prueba cerrada de Ñan Kamay y recibe la app antes que nadie. Grabación GPS de rutas, mapas offline y seguridad en montaña.';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Prueba cerrada</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0D1B12" />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <style>
      :root { --night:#0d1b12; --card:#1b4332; --line:#2d6a4f; --accent:#f59e0b; --ink:#fff; --soft:#cfe0d7; --muted:#8fae9e; --danger:#ef4444; --ok:#22c55e; }
      * { box-sizing:border-box; }
      body { margin:0; background:var(--night); color:var(--ink);
             font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; line-height:1.6; }
      .wrap { max-width:640px; margin:0 auto; padding:32px 20px 64px; }
      .hidden { display:none !important; }

      header { display:flex; align-items:center; gap:12px; margin-bottom:22px; }
      header img { width:40px; height:40px; border-radius:10px; }
      header a { color:var(--ink); text-decoration:none; font-weight:800; font-size:18px; }

      .pill { display:inline-block; font-size:12px; font-weight:800; letter-spacing:.03em;
              color:var(--accent); background:rgba(245,158,11,.12); border:1px solid rgba(245,158,11,.35);
              border-radius:999px; padding:4px 12px; }
      h1 { font-size:28px; line-height:1.25; margin:14px 0 8px; }
      .lead { color:var(--soft); font-size:16px; margin:0 0 26px; }
      h2 { font-size:18px; margin:0 0 6px; }
      p, li { color:var(--soft); font-size:15px; }
      a { color:var(--accent); }
      strong { color:#fff; }

      .card { background:rgba(27,67,50,.4); border:1px solid var(--line); border-radius:16px;
              padding:20px; margin:0 0 18px; }
      label { display:block; font-size:14px; font-weight:700; color:var(--ink); margin:14px 0 6px; }
      input[type=text], input[type=email] {
        width:100%; background:#14291d; border:1px solid var(--line); border-radius:12px;
        color:var(--ink); font-size:16px; padding:13px 14px; font-family:inherit; }
      input:focus { outline:2px solid var(--accent); outline-offset:1px; }
      .hint { color:var(--muted); font-size:13px; margin:6px 0 0; }
      .check { display:flex; gap:10px; align-items:flex-start; margin:18px 0 0; font-weight:400; }
      .check input { margin-top:4px; width:18px; height:18px; accent-color:var(--accent); flex:none; }
      .check span { color:var(--soft); font-size:13.5px; line-height:1.5; }

      .cta { display:block; width:100%; margin-top:18px; background:var(--accent); color:var(--night);
             font-weight:800; font-size:15px; font-family:inherit; text-align:center; text-decoration:none;
             padding:14px 18px; border:0; border-radius:12px; cursor:pointer; }
      .cta:disabled { opacity:.6; cursor:progress; }
      .ghost { display:block; width:100%; margin-top:10px; background:transparent; color:var(--ink);
               border:1px solid var(--line); border-radius:12px; padding:12px 18px; font-weight:700;
               font-size:14px; font-family:inherit; cursor:pointer; text-align:center; }

      .warn { border:1px solid rgba(245,158,11,.5); background:rgba(245,158,11,.1); border-radius:12px;
              padding:12px 14px; margin-top:16px; font-size:13.5px; color:var(--soft); }
      .error { color:var(--danger); font-size:13.5px; margin:12px 0 0; }

      .steps { list-style:none; counter-reset:s; padding:0; margin:18px 0 0; }
      .steps li { counter-increment:s; position:relative; padding:0 0 0 42px; margin:0 0 24px; }
      .steps li::before { content:counter(s); position:absolute; left:0; top:0; width:28px; height:28px;
              border-radius:50%; background:var(--accent); color:var(--night); font-weight:800;
              font-size:14px; display:grid; place-items:center; }
      .steps h3 { margin:2px 0 4px; font-size:16px; color:#fff; }
      .steps p { margin:0; font-size:14px; }

      .note { border:1px solid var(--line); background:rgba(13,27,18,.6); border-radius:12px;
              padding:13px 15px; margin-top:6px; font-size:13.5px; color:var(--soft); }
      ul.plain { padding-left:20px; margin:10px 0 0; }
      ul.plain li { margin:6px 0; font-size:14.5px; }
      details { border-top:1px solid var(--line); padding:14px 0 2px; }
      details summary { cursor:pointer; font-weight:700; font-size:14.5px; color:var(--ink); }
      details p { margin:8px 0 4px; font-size:14px; }
      .back { display:inline-block; margin-top:22px; color:var(--accent); text-decoration:none; font-weight:700; }
      .ok { color:var(--ok); font-size:13.5px; margin:10px 0 0; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <img src={logo} alt="Ñan Kamay" width="40" height="40" />
        <a href={home}>Ñan Kamay</a>
      </header>

      <span class="pill">PRUEBA CERRADA · ANDROID</span>
      <h1>Sé de los primeros en usar Ñan Kamay</h1>
      <p class="lead">
        Estamos en pruebas cerradas en Google Play. Déjanos tu correo y te damos acceso a la app
        completa: grabación GPS de rutas, mapas offline, waypoints con fotos y el seguimiento en
        vivo para que alguien sepa dónde estás en la montaña.
      </p>

      <!-- ── Paso 1: alta ─────────────────────────────────────── -->
      <section class="card" id="step-form">
        <h2>Apúntate</h2>
        <p class="hint">Es gratis y puedes salirte cuando quieras.</p>
        <form id="form" novalidate>
          <label for="name">Tu nombre</label>
          <input id="name" name="name" type="text" autocomplete="name" placeholder="Cómo te llamamos" />

          <label for="email">Correo de tu cuenta de Google *</label>
          <input id="email" name="email" type="email" inputmode="email" autocomplete="email"
                 placeholder="tucorreo@gmail.com" required />
          <p class="hint">
            Tiene que ser <strong>la cuenta con la que entras a Google Play</strong> en tu teléfono.
            Si nos das otra, la app no te aparecerá.
          </p>

          <div class="warn hidden" id="warn">
            Ese correo no parece una cuenta de Gmail. Solo funciona si es la cuenta de Google que
            usas en el Play Store de tu teléfono. Si lo es, continúa.
          </div>

          <label class="check" for="consent">
            <input id="consent" type="checkbox" />
            <span>Acepto que guarden mi nombre y correo para darme acceso a la prueba y avisarme de
              novedades. Se borra al terminar la beta — <a href={privacidad}>política de privacidad</a>.</span>
          </label>

          <button class="cta" id="submit" type="submit">Quiero ser tester</button>
          <p class="error hidden" id="error" role="alert"></p>
        </form>
      </section>

      <!-- ── Paso 2: qué hacer ahora ──────────────────────────── -->
      <section class="card hidden" id="step-done">
        <h2 id="done-title">¡Listo! Faltan dos pasos</h2>
        <p class="hint">Los dos son obligatorios: así funciona Google Play, no podemos saltárnoslos.</p>

        <ol class="steps">
          <li>
            <h3>Únete al grupo de testers</h3>
            <p>Google da el acceso a través de este grupo. Sin estar dentro, la app no te llega.</p>
            <a class="cta" id="join" href={SITE.testersGroupUrl} target="_blank" rel="noopener">Unirme al grupo</a>
            <p class="hint">
              ¿Te pide iniciar sesión o no carga? También puedes
              <a href={SITE.testersJoinMailto}>unirte enviando un correo vacío</a>.
            </p>
          </li>
          <li>
            <h3>Acepta la prueba y descarga</h3>
            <p>Abre este enlace en el teléfono y toca el botón para convertirte en verificador.</p>
            <a class="cta" id="optin" href={SITE.playOptInUrl} target="_blank" rel="noopener">Aceptar y descargar</a>
          </li>
        </ol>

        <div class="note">
          ⏱️ Entre que te unes al grupo y que Google Play te reconoce pasan <strong>unos minutos</strong>.
          Si al abrir el segundo enlace todavía no te deja, espera un rato y vuelve a intentarlo — es normal.
        </div>

        <button class="ghost" id="copy" type="button">Copiar los 2 enlaces</button>
        <p class="ok hidden" id="copied">Enlaces copiados.</p>
        <button class="ghost hidden" id="again" type="button">Apuntar otro correo</button>
      </section>

      <!-- ── Qué esperamos ────────────────────────────────────── -->
      <section class="card">
        <h2>Qué esperamos de ti</h2>
        <ul class="plain">
          <li><strong>Que no la desinstales durante 2 semanas.</strong> Google exige que el grupo de
            testers se mantenga estable ese tiempo; si te sales, la prueba se atrasa para todos.</li>
          <li><strong>Que la uses en una salida real</strong> — una caminata, un cerro, lo que hagas
            normalmente. Es donde aparecen los fallos que importan.</li>
          <li><strong>Que nos cuentes lo que falle</strong> desde <em>Perfil → Reportar un problema</em>,
            dentro de la app. Llega directo, con la versión y la pantalla.</li>
        </ul>
      </section>

      <h2 style="margin-top:30px">Dudas frecuentes</h2>
      <details>
        <summary>Me uní al grupo pero la app no me aparece en Play</summary>
        <p>Casi siempre son dos cosas: (1) todavía no pasaron los minutos de propagación, o (2) el
          teléfono está usando otra cuenta de Google. Comprueba en Play Store → tu foto de perfil que
          la cuenta activa sea la misma que nos diste, y vuelve a abrir el enlace de la prueba.</p>
      </details>
      <details>
        <summary>¿Cuesta algo?</summary>
        <p>No. La app es gratuita y no tiene anuncios ni compras.</p>
      </details>
      <details>
        <summary>¿Qué hacen con mi correo?</summary>
        <p>Se guarda solo para darte acceso a la prueba y avisarte de novedades de la beta. No se
          comparte con nadie y se borra cuando termine. Detalle en la
          <a href={privacidad}>política de privacidad</a>.</p>
      </details>
      <details>
        <summary>¿Cómo me salgo?</summary>
        <p>Sales del grupo de Google cuando quieras y desinstalas la app. Si prefieres avisarnos,
          escribe a <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
      </details>

      <a class="back" href={home}>← Volver al inicio</a>
    </div>

    <script
      is:inline
      define:vars={{
        SUPABASE_URL: SITE.supabaseUrl,
        SUPABASE_ANON_KEY: SITE.supabaseAnonKey,
        GROUP_URL: SITE.testersGroupUrl,
        PLAY_URL: SITE.playOptInUrl,
      }}
    >
      (function () {
        var form = document.getElementById('form');
        var nameEl = document.getElementById('name');
        var emailEl = document.getElementById('email');
        var consentEl = document.getElementById('consent');
        var btn = document.getElementById('submit');
        var warnEl = document.getElementById('warn');
        var errEl = document.getElementById('error');
        var stepForm = document.getElementById('step-form');
        var stepDone = document.getElementById('step-done');
        var doneTitle = document.getElementById('done-title');
        var againBtn = document.getElementById('again');
        var copyBtn = document.getElementById('copy');
        var copiedEl = document.getElementById('copied');

        var EMAIL = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
        var GOOGLE = /@(gmail\.com|googlemail\.com)$/i;
        var STORE_KEY = 'nk_beta_signup';
        var LABEL = btn.textContent;
        var warned = false;

        function fail(msg) { errEl.textContent = msg; errEl.classList.remove('hidden'); }
        function clearFail() { errEl.classList.add('hidden'); errEl.textContent = ''; }

        function showDone(who, returning) {
          doneTitle.textContent = returning
            ? (who ? 'Ya estás apuntado, ' + who : 'Ya estás apuntado')
            : (who ? '¡Listo, ' + who + '! Faltan dos pasos' : '¡Listo! Faltan dos pasos');
          stepForm.classList.add('hidden');
          stepDone.classList.remove('hidden');
          againBtn.classList.remove('hidden');
        }

        // Si ya se apuntó en este navegador, no le pedimos el correo otra vez:
        // lo que necesita al volver son los dos enlaces.
        try {
          var saved = localStorage.getItem(STORE_KEY);
          if (saved) showDone(JSON.parse(saved).name, true);
        } catch (e) {}

        againBtn.addEventListener('click', function () {
          try { localStorage.removeItem(STORE_KEY); } catch (e) {}
          stepDone.classList.add('hidden');
          stepForm.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = LABEL;
          warned = false;
          warnEl.classList.add('hidden');
          emailEl.value = '';
          emailEl.focus();
        });

        copyBtn.addEventListener('click', function () {
          var text = '1) Únete al grupo de testers: ' + GROUP_URL +
                     '\n2) Acepta la prueba y descarga: ' + PLAY_URL;
          var done = function () {
            copiedEl.classList.remove('hidden');
            setTimeout(function () { copiedEl.classList.add('hidden'); }, 2500);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done, function () { window.prompt('Copia los enlaces:', text); });
          } else {
            window.prompt('Copia los enlaces:', text);
          }
        });

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          clearFail();

          var name = nameEl.value.trim();
          var email = emailEl.value.trim().toLowerCase();

          if (!EMAIL.test(email)) { fail('Revisa el correo: parece incompleto.'); emailEl.focus(); return; }
          if (!consentEl.checked) { fail('Marca la casilla para poder darte acceso.'); return; }

          // Aviso, no bloqueo: hay cuentas de Google con dominio propio. El error
          // nº 1 de los testers es dar el correo del trabajo y luego no ver la app.
          if (!GOOGLE.test(email) && !warned) {
            warned = true;
            warnEl.classList.remove('hidden');
            btn.textContent = 'Sí, es mi cuenta de Google — continuar';
            return;
          }

          btn.disabled = true;
          btn.textContent = 'Enviando…';

          fetch(SUPABASE_URL + '/rest/v1/rpc/nk_register_tester', {
            method: 'POST',
            headers: {
              'apikey': SUPABASE_ANON_KEY,
              'Authorization': 'Bearer ' + SUPABASE_ANON_KEY,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ p_email: email, p_name: name || null, p_source: 'landing' }),
          })
            .then(function (res) {
              if (res.ok) return null;
              return res.json().catch(function () { return null; }).then(function (body) {
                var code = body && body.message ? body.message : '';
                if (code === 'email_invalido') throw new Error('Revisa el correo: parece incompleto.');
                if (code === 'demasiadas_altas') throw new Error('Estamos recibiendo muchas solicitudes. Inténtalo en unos minutos.');
                throw new Error('No pudimos guardar tu correo (error ' + res.status + '). Escríbenos y te apuntamos a mano.');
              });
            })
            .then(function () {
              try { localStorage.setItem(STORE_KEY, JSON.stringify({ name: name, email: email })); } catch (e) {}
              showDone(name, false);
              stepDone.scrollIntoView({ behavior: 'smooth', block: 'start' });
            })
            .catch(function (err) {
              fail(err && err.message ? err.message : 'No pudimos conectar. Revisa tu conexión e inténtalo de nuevo.');
              btn.disabled = false;
              btn.textContent = LABEL;
            });
        });
      })();
    </script>
  </body>
</html>
