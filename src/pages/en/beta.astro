---
// Tester sign-up for the Google Play CLOSED TEST (English version of /beta).
//
// Why this page exists: the Play Developer API only accepts Google GROUPS as the
// tester list (never individual emails), so kamay-testers@googlegroups.com — set
// once in Play Console — IS the list. Here we only (1) store the email for our own
// retention audit and (2) walk the person through joining the group and opting in.
//
// Static site on GitHub Pages: the POST goes straight from the browser to the
// nk_register_tester RPC with the publishable key, same as the live viewer in
// 404.astro. The nk_testers table is closed (no policies, no grants); only that
// SECURITY DEFINER RPC writes, so the public key cannot read the emails.
import { withBase } from '../../i18n/utils';
import { SITE } from '../../config';
const logo = withBase('/icon.png');
const home = withBase('/en');
const privacy = withBase('/en/privacy');
const ogImage = withBase('/og.png');
const title = 'Become a Ñan Kamay tester';
const description =
  'Join the Ñan Kamay closed test and get the app before anyone else. GPS trail recording, offline maps and mountain safety.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Closed test</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0D1B12" />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    <link rel="alternate" hreflang="es" href={withBase('/beta')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <style>
      :root { --night:#0d1b12; --card:#1b4332; --line:#2d6a4f; --accent:#f59e0b; --ink:#fff; --soft:#cfe0d7; --muted:#8fae9e; --danger:#ef4444; --ok:#22c55e; }
      * { box-sizing:border-box; }
      body { margin:0; background:var(--night); color:var(--ink);
             font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; line-height:1.6; }
      .wrap { max-width:640px; margin:0 auto; padding:32px 20px 64px; }
      .hidden { display:none !important; }

      header { display:flex; align-items:center; gap:12px; margin-bottom:22px; }
      header img { width:40px; height:40px; border-radius:10px; }
      header a { color:var(--ink); text-decoration:none; font-weight:800; font-size:18px; }

      .pill { display:inline-block; font-size:12px; font-weight:800; letter-spacing:.03em;
              color:var(--accent); background:rgba(245,158,11,.12); border:1px solid rgba(245,158,11,.35);
              border-radius:999px; padding:4px 12px; }
      h1 { font-size:28px; line-height:1.25; margin:14px 0 8px; }
      .lead { color:var(--soft); font-size:16px; margin:0 0 26px; }
      h2 { font-size:18px; margin:0 0 6px; }
      p, li { color:var(--soft); font-size:15px; }
      a { color:var(--accent); }
      strong { color:#fff; }

      .card { background:rgba(27,67,50,.4); border:1px solid var(--line); border-radius:16px;
              padding:20px; margin:0 0 18px; }
      label { display:block; font-size:14px; font-weight:700; color:var(--ink); margin:14px 0 6px; }
      input[type=text], input[type=email] {
        width:100%; background:#14291d; border:1px solid var(--line); border-radius:12px;
        color:var(--ink); font-size:16px; padding:13px 14px; font-family:inherit; }
      input:focus { outline:2px solid var(--accent); outline-offset:1px; }
      .hint { color:var(--muted); font-size:13px; margin:6px 0 0; }
      .check { display:flex; gap:10px; align-items:flex-start; margin:18px 0 0; font-weight:400; }
      .check input { margin-top:4px; width:18px; height:18px; accent-color:var(--accent); flex:none; }
      .check span { color:var(--soft); font-size:13.5px; line-height:1.5; }

      .cta { display:block; width:100%; margin-top:18px; background:var(--accent); color:var(--night);
             font-weight:800; font-size:15px; font-family:inherit; text-align:center; text-decoration:none;
             padding:14px 18px; border:0; border-radius:12px; cursor:pointer; }
      .cta:disabled { opacity:.6; cursor:progress; }
      .ghost { display:block; width:100%; margin-top:10px; background:transparent; color:var(--ink);
               border:1px solid var(--line); border-radius:12px; padding:12px 18px; font-weight:700;
               font-size:14px; font-family:inherit; cursor:pointer; text-align:center; }

      .warn { border:1px solid rgba(245,158,11,.5); background:rgba(245,158,11,.1); border-radius:12px;
              padding:12px 14px; margin-top:16px; font-size:13.5px; color:var(--soft); }
      .error { color:var(--danger); font-size:13.5px; margin:12px 0 0; }

      .steps { list-style:none; counter-reset:s; padding:0; margin:18px 0 0; }
      .steps li { counter-increment:s; position:relative; padding:0 0 0 42px; margin:0 0 24px; }
      .steps li::before { content:counter(s); position:absolute; left:0; top:0; width:28px; height:28px;
              border-radius:50%; background:var(--accent); color:var(--night); font-weight:800;
              font-size:14px; display:grid; place-items:center; }
      .steps h3 { margin:2px 0 4px; font-size:16px; color:#fff; }
      .steps p { margin:0; font-size:14px; }

      .note { border:1px solid var(--line); background:rgba(13,27,18,.6); border-radius:12px;
              padding:13px 15px; margin-top:6px; font-size:13.5px; color:var(--soft); }
      ul.plain { padding-left:20px; margin:10px 0 0; }
      ul.plain li { margin:6px 0; font-size:14.5px; }
      details { border-top:1px solid var(--line); padding:14px 0 2px; }
      details summary { cursor:pointer; font-weight:700; font-size:14.5px; color:var(--ink); }
      details p { margin:8px 0 4px; font-size:14px; }
      .back { display:inline-block; margin-top:22px; color:var(--accent); text-decoration:none; font-weight:700; }
      .ok { color:var(--ok); font-size:13.5px; margin:10px 0 0; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header>
        <img src={logo} alt="Ñan Kamay" width="40" height="40" />
        <a href={home}>Ñan Kamay</a>
      </header>

      <span class="pill">CLOSED TEST · ANDROID</span>
      <h1>Be among the first to use Ñan Kamay</h1>
      <p class="lead">
        We're in closed testing on Google Play. Leave us your email and we'll give you access to the
        full app: GPS trail recording, offline maps, waypoints with photos and live tracking so
        someone always knows where you are in the mountains.
      </p>

      <!-- ── Step 1: sign up ─────────────────────────────────── -->
      <section class="card" id="step-form">
        <h2>Sign up</h2>
        <p class="hint">It's free and you can leave whenever you want.</p>
        <form id="form" novalidate>
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" autocomplete="name" placeholder="What should we call you" />

          <label for="email">Your Google account email *</label>
          <input id="email" name="email" type="email" inputmode="email" autocomplete="email"
                 placeholder="you@gmail.com" required />
          <p class="hint">
            It must be <strong>the account you use on Google Play</strong> on your phone.
            With any other one, the app won't show up for you.
          </p>

          <div class="warn hidden" id="warn">
            That doesn't look like a Gmail address. It only works if it's the Google account you use
            in the Play Store on your phone. If it is, go ahead.
          </div>

          <label class="check" for="consent">
            <input id="consent" type="checkbox" />
            <span>I agree to you storing my name and email to give me access to the test and tell me
              about updates. It's deleted when the beta ends — <a href={privacy}>privacy policy</a>.</span>
          </label>

          <button class="cta" id="submit" type="submit">I want to be a tester</button>
          <p class="error hidden" id="error" role="alert"></p>
        </form>
      </section>

      <!-- ── Step 2: what to do now ──────────────────────────── -->
      <section class="card hidden" id="step-done">
        <h2 id="done-title">You're in! Two steps left</h2>
        <p class="hint">Both are required: that's how Google Play works, we can't skip them.</p>

        <ol class="steps">
          <li>
            <h3>Join the testers group</h3>
            <p>Google grants access through this group. If you're not in it, the app won't reach you.</p>
            <a class="cta" id="join" href={SITE.testersGroupUrl} target="_blank" rel="noopener">Join the group</a>
            <p class="hint">
              Asking you to sign in, or not loading?
              <a href={SITE.testersJoinMailto}>Join by sending an empty email</a> instead.
            </p>
          </li>
          <li>
            <h3>Opt in and download</h3>
            <p>Open this link on your phone and tap the button to become a tester.</p>
            <a class="cta" id="optin" href={SITE.playOptInUrl} target="_blank" rel="noopener">Opt in and download</a>
          </li>
        </ol>

        <div class="note">
          ⏱️ It takes <strong>a few minutes</strong> between joining the group and Google Play
          recognising you. If the second link won't let you in yet, wait a bit and try again — that's normal.
        </div>

        <button class="ghost" id="copy" type="button">Copy both links</button>
        <p class="ok hidden" id="copied">Links copied.</p>
        <button class="ghost hidden" id="again" type="button">Sign up another email</button>
      </section>

      <!-- ── What we expect ──────────────────────────────────── -->
      <section class="card">
        <h2>What we expect from you</h2>
        <ul class="plain">
          <li><strong>Don't uninstall it for 2 weeks.</strong> Google requires the tester group to stay
            stable for that long; if you drop out, the test is delayed for everyone.</li>
          <li><strong>Use it on a real outing</strong> — a hike, a summit, whatever you normally do.
            That's where the bugs that matter show up.</li>
          <li><strong>Tell us what breaks</strong> from <em>Profile → Report a problem</em>, inside the
            app. It reaches us directly, with the version and the screen.</li>
        </ul>
      </section>

      <h2 style="margin-top:30px">Common questions</h2>
      <details>
        <summary>I joined the group but the app doesn't show up on Play</summary>
        <p>It's almost always one of two things: (1) the propagation minutes haven't passed yet, or
          (2) your phone is signed in with a different Google account. Check in Play Store → your
          profile picture that the active account is the one you gave us, then open the test link again.</p>
      </details>
      <details>
        <summary>Does it cost anything?</summary>
        <p>No. The app is free, with no ads and no in-app purchases.</p>
      </details>
      <details>
        <summary>What do you do with my email?</summary>
        <p>It's stored only to give you access to the test and tell you about beta updates. It isn't
          shared with anyone and it's deleted when the test ends. Details in the
          <a href={privacy}>privacy policy</a>.</p>
      </details>
      <details>
        <summary>How do I leave?</summary>
        <p>Leave the Google group whenever you want and uninstall the app. If you'd rather tell us,
          write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
      </details>

      <a class="back" href={home}>← Back to home</a>
    </div>

    <script
      is:inline
      define:vars={{
        SUPABASE_URL: SITE.supabaseUrl,
        SUPABASE_ANON_KEY: SITE.supabaseAnonKey,
        GROUP_URL: SITE.testersGroupUrl,
        PLAY_URL: SITE.playOptInUrl,
      }}
    >
      (function () {
        var form = document.getElementById('form');
        var nameEl = document.getElementById('name');
        var emailEl = document.getElementById('email');
        var consentEl = document.getElementById('consent');
        var btn = document.getElementById('submit');
        var warnEl = document.getElementById('warn');
        var errEl = document.getElementById('error');
        var stepForm = document.getElementById('step-form');
        var stepDone = document.getElementById('step-done');
        var doneTitle = document.getElementById('done-title');
        var againBtn = document.getElementById('again');
        var copyBtn = document.getElementById('copy');
        var copiedEl = document.getElementById('copied');

        var EMAIL = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
        var GOOGLE = /@(gmail\.com|googlemail\.com)$/i;
        var STORE_KEY = 'nk_beta_signup';
        var LABEL = btn.textContent;
        var warned = false;

        function fail(msg) { errEl.textContent = msg; errEl.classList.remove('hidden'); }
        function clearFail() { errEl.classList.add('hidden'); errEl.textContent = ''; }

        function showDone(who, returning) {
          doneTitle.textContent = returning
            ? (who ? "You're already signed up, " + who : "You're already signed up")
            : (who ? "You're in, " + who + '! Two steps left' : "You're in! Two steps left");
          stepForm.classList.add('hidden');
          stepDone.classList.remove('hidden');
          againBtn.classList.remove('hidden');
        }

        // If they already signed up in this browser, don't ask for the email again:
        // what they need when coming back are the two links.
        try {
          var saved = localStorage.getItem(STORE_KEY);
          if (saved) showDone(JSON.parse(saved).name, true);
        } catch (e) {}

        againBtn.addEventListener('click', function () {
          try { localStorage.removeItem(STORE_KEY); } catch (e) {}
          stepDone.classList.add('hidden');
          stepForm.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = LABEL;
          warned = false;
          warnEl.classList.add('hidden');
          emailEl.value = '';
          emailEl.focus();
        });

        copyBtn.addEventListener('click', function () {
          var text = '1) Join the testers group: ' + GROUP_URL +
                     '\n2) Opt in and download: ' + PLAY_URL;
          var done = function () {
            copiedEl.classList.remove('hidden');
            setTimeout(function () { copiedEl.classList.add('hidden'); }, 2500);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done, function () { window.prompt('Copy the links:', text); });
          } else {
            window.prompt('Copy the links:', text);
          }
        });

        form.addEventListener('submit', function (e) {
          e.preventDefault();
          clearFail();

          var name = nameEl.value.trim();
          var email = emailEl.value.trim().toLowerCase();

          if (!EMAIL.test(email)) { fail('Check the email: it looks incomplete.'); emailEl.focus(); return; }
          if (!consentEl.checked) { fail('Tick the box so we can give you access.'); return; }

          // Warn, don't block: there are Google accounts on custom domains. The #1
          // mistake is giving a work address and then not seeing the app.
          if (!GOOGLE.test(email) && !warned) {
            warned = true;
            warnEl.classList.remove('hidden');
            btn.textContent = 'Yes, that’s my Google account — continue';
            return;
          }

          btn.disabled = true;
          btn.textContent = 'Sending…';

          fetch(SUPABASE_URL + '/rest/v1/rpc/nk_register_tester', {
            method: 'POST',
            headers: {
              'apikey': SUPABASE_ANON_KEY,
              'Authorization': 'Bearer ' + SUPABASE_ANON_KEY,
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ p_email: email, p_name: name || null, p_source: 'landing-en' }),
          })
            .then(function (res) {
              if (res.ok) return null;
              return res.json().catch(function () { return null; }).then(function (body) {
                var code = body && body.message ? body.message : '';
                if (code === 'email_invalido') throw new Error('Check the email: it looks incomplete.');
                if (code === 'demasiadas_altas') throw new Error('We are getting a lot of sign-ups. Try again in a few minutes.');
                throw new Error('We could not save your email (error ' + res.status + '). Write to us and we will add you by hand.');
              });
            })
            .then(function () {
              try { localStorage.setItem(STORE_KEY, JSON.stringify({ name: name, email: email })); } catch (e) {}
              showDone(name, false);
              stepDone.scrollIntoView({ behavior: 'smooth', block: 'start' });
            })
            .catch(function (err) {
              fail(err && err.message ? err.message : 'We could not connect. Check your connection and try again.');
              btn.disabled = false;
              btn.textContent = LABEL;
            });
        });
      })();
    </script>
  </body>
</html>
